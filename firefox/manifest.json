{
  "manifest_version": 3,
  "name": "Poyori: 8-Bit Virtual Web Companion",
  "version": "2.0.0",
  "description": "Raise Poyori, your 8-bit retro virtual pet roaming web pages in Mochimori. Complete tasks, study, and maintain streaks to evolve your companion!",
  "browser_specific_settings": {
    "gecko": {
      "id": "poyori-companion@mochimori.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.bundle.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/icons/*",
        "assets/fonts/*",
        "blocked/*",
        "content/*",
        "ui/*",
        "dashboard/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
